# Test SELECT-17
#
# Assumes this table:
#
#   CREATE TABLE numbers(code INTEGER PRIMARY KEY, textcode TEXT, altcode INTEGER);
#
# claude: two-sided range that collapses to exactly the one row also hit
# by sql-select-014.dbmf's single-sided `<=` test (`altcode = 20`), but
# reached here via a lower bound (`SeekGe`) plus an upper-bound check
# that only the very first visited row can pass.

USE 1table-largebtree.cdb

%%

SELECT code FROM numbers WHERE altcode >= 20 AND altcode <= 20;

%%

3720
