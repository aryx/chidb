# Test SELECT-12
#
# Assumes this table:
#
#   CREATE TABLE numbers(code INTEGER PRIMARY KEY, textcode TEXT, altcode INTEGER);
#
# claude: this file also has an index on altcode (idxNumbers, per
# testing.html); `>=` on the indexed column now compiles to an index
# seek (SeekGe) that walks forward, instead of a full scan -- see
# sql-select-003.dbmf's updated comment for why that changes row order
# (ascending altcode here) but not the row set, versus the `code`-based
# tests above which query the primary key and are unaffected either way.

USE 1table-largebtree.cdb

%%

SELECT code FROM numbers WHERE altcode >= 9980;

%%

9861
6853
597
7912
