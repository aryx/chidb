# Test SELECT-14
#
# Assumes this table:
#
#   CREATE TABLE numbers(code INTEGER PRIMARY KEY, textcode TEXT, altcode INTEGER);
#
# `<=` on the indexed altcode column: index seek (SeekLe) walking
# backward from the boundary, which this time includes an exact match
# (altcode = 20, code 3720) as the first (largest-qualifying) row.

USE 1table-largebtree.cdb

%%

SELECT code FROM numbers WHERE altcode <= 20;

%%

3720
241
