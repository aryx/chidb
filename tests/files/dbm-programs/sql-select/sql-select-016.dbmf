# Test SELECT-16
#
# Assumes this table:
#
#   CREATE TABLE numbers(code INTEGER PRIMARY KEY, textcode TEXT, altcode INTEGER);
#
# claude: two-sided bounded range on the indexed altcode column (`WHERE
# altcode > 9980 AND altcode < 9990`) -- compiles to a single SeekGt
# followed by a per-row upper-bound check, instead of falling back to a
# full scan (see codegen.c's detect_range_pair). Rows come back in
# ascending altcode order, same as a single-sided `>`/`>=` range.

USE 1table-largebtree.cdb

%%

SELECT code FROM numbers WHERE altcode > 9980 AND altcode < 9990;

%%

9861
6853
