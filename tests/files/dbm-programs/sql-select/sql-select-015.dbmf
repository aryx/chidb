# Test SELECT-15
#
# Assumes this table:
#
#   CREATE TABLE numbers(code INTEGER PRIMARY KEY, textcode TEXT, altcode INTEGER);
#
# `<` on the indexed altcode column with no qualifying rows at all: the
# initial SeekLt itself must fail cleanly (zero rows, no crash), as
# opposed to sql-select-010.dbmf/011.dbmf's no-match tests, which query
# the (unindexed, so always a plain scan) primary key instead.

USE 1table-largebtree.cdb

%%

SELECT code FROM numbers WHERE altcode < 1;

%%

# No query results
