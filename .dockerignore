Dockerfile
.git

# Generated by ./configure - do not edit by hand, re-run ./configure instead.
/Makefile.config

# Build output (host artifacts must not leak into the image - a
# container build should compile from source, not inherit whatever
# happens to be lying around on the developer's machine)
**/*.o
**/*.d
**/*.a
/chidb

# flex/bison output (generated from .l/.y by src/libchisql/Makefile)
src/libchisql/sql-lexer.c
src/libchisql/sql-lexer.h
src/libchisql/sql-parser.c
src/libchisql/sql-parser.h

# Test suite output
tests/check_btree
tests/check_dbm
tests/check_dbrecord
tests/check_pager
tests/check_utils
