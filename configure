#!/bin/sh
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# Replaces the old autoconf/automake/libtool build (configure.ac +
# Makefile.am, generating a 480KB configure script and a 148KB
# Makefile.in for a project with five directories). Modeled on
# ~/goken/configure and ~/xv6/configure: a short shell script that
# probes for the handful of things this project actually needs and
# writes them into Makefile.config, which the hand-written top-level
# Makefile (and the Makefile in each src/*/ and tests/) includes.
#
# What's probed:
#  - a C compiler (CC, default cc)
#  - flex/bison, to regenerate src/libchisql/sql-{lexer,parser}.[ch]
#    from sql.l/sql.y
#
# The test suite (`make check`/`make test`) needs no probing: it's
# built against libs/check, a small vendored reimplementation of the
# Check unit-testing API (see libs/check/check.h), not an external
# library.
#
# Unlike autoconf, this does not generate a config.h: nothing in the
# tree actually uses any of the HAVE_* macros the old config.h.in
# defined (grep for HAVE_CONFIG_H turns up only automake's own
# boilerplate -DHAVE_CONFIG_H, never #include <config.h> in any .c/.h),
# so there's nothing to generate.

###############################################################################
# Entry point
###############################################################################

CC=${CC:-cc}
LEX=${LEX:-flex}
YACC=${YACC:-bison}

for arg in "$@"; do
    case "$arg" in
        CC=*)   CC="${arg#CC=}" ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  CC=compiler   use this C compiler instead of \$CC/cc"
            echo
            echo "flex/bison are auto-detected; there is nothing to configure for those."
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

# Printed once total, not once per missing piece.
PKGMGR_HINTED=no
note_other_pkgmgr() {
    if [ "$PKGMGR_HINTED" = no ]; then
        echo "  (other distros/OSes: look for the equivalent packages in your own" >&2
        echo "  package manager, e.g. pacman/dnf/brew)" >&2
        PKGMGR_HINTED=yes
    fi
}

###############################################################################
# C compiler
###############################################################################
if ! command -v "$CC" >/dev/null 2>&1; then
    echo "configure: error: no C compiler found (tried '$CC')" >&2
    echo "  install one, e.g. on Debian/Ubuntu: apt-get install build-essential" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $CC"

###############################################################################
# flex / bison, for src/libchisql/sql.l and sql.y
###############################################################################
if ! command -v "$LEX" >/dev/null 2>&1; then
    echo "configure: error: '$LEX' not found (needed to compile src/libchisql/sql.l)" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install flex" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $LEX"

if ! command -v "$YACC" >/dev/null 2>&1; then
    echo "configure: error: '$YACC' not found (needed to compile src/libchisql/sql.y)" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install bison" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $YACC"

###############################################################################
# Write Makefile.config
###############################################################################
{
    echo "# Generated by ./configure - do not edit by hand, re-run ./configure instead."
    echo "CC = $CC"
    echo "AR = ar"
    echo "LEX = $LEX"
    echo "YACC = $YACC"
} > Makefile.config

echo "wrote Makefile.config"
echo
echo "Next: make            && ./chidb"
echo "  or: make check       (alias: make test)"
