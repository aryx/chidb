#!/bin/sh
#config: to debug this script add also '-x' to the set below
set -eu

###############################################################################
# Prelude
###############################################################################
# Replaces the old autoconf/automake/libtool build (configure.ac +
# Makefile.am, generating a 480KB configure script and a 148KB
# Makefile.in for a project with five directories). Modeled on
# ~/goken/configure and ~/xv6/configure: a short shell script that
# probes for the handful of things this project actually needs and
# writes them into Makefile.config, which the hand-written top-level
# Makefile (and the Makefile in each src/*/ and tests/) includes.
#
# What's probed:
#  - a C compiler (CC, default cc)
#  - flex/bison, to regenerate src/libchisql/sql-{lexer,parser}.[ch]
#    from sql.l/sql.y
#  - libedit (histedit.h + -ledit), for the interactive shell's line
#    editing (src/shell/main.c)
#  - the Check unit-testing library (optional: if missing, `make
#    check`/`make test` still builds everything but skips the test
#    binaries with a warning, matching the old configure.ac's
#    PKG_CHECK_MODULES behavior)
#
# Unlike autoconf, this does not generate a config.h: nothing in the
# tree actually uses any of the HAVE_* macros the old config.h.in
# defined (grep for HAVE_CONFIG_H turns up only automake's own
# boilerplate -DHAVE_CONFIG_H, never #include <config.h> in any .c/.h),
# so there's nothing to generate.

###############################################################################
# Entry point
###############################################################################

CC=${CC:-cc}
LEX=${LEX:-flex}
YACC=${YACC:-bison}

for arg in "$@"; do
    case "$arg" in
        CC=*)   CC="${arg#CC=}" ;;
        --help|-h)
            echo "Usage: ./configure [options]"
            echo "  CC=compiler   use this C compiler instead of \$CC/cc"
            echo
            echo "flex/bison, libedit and (optionally) the Check test library are"
            echo "auto-detected; there is nothing to configure for those."
            exit 0
            ;;
        *)
            echo "Unknown option: $arg" >&2
            echo "Try: ./configure --help" >&2
            exit 1
            ;;
    esac
done

WORKDIR=`mktemp -d`
trap 'rm -rf "$WORKDIR"' EXIT

# Printed once total, not once per missing piece.
PKGMGR_HINTED=no
note_other_pkgmgr() {
    if [ "$PKGMGR_HINTED" = no ]; then
        echo "  (other distros/OSes: look for the equivalent packages in your own" >&2
        echo "  package manager, e.g. pacman/dnf/brew)" >&2
        PKGMGR_HINTED=yes
    fi
}

###############################################################################
# C compiler
###############################################################################
if ! command -v "$CC" >/dev/null 2>&1; then
    echo "configure: error: no C compiler found (tried '$CC')" >&2
    echo "  install one, e.g. on Debian/Ubuntu: apt-get install build-essential" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $CC"

###############################################################################
# flex / bison, for src/libchisql/sql.l and sql.y
###############################################################################
if ! command -v "$LEX" >/dev/null 2>&1; then
    echo "configure: error: '$LEX' not found (needed to compile src/libchisql/sql.l)" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install flex" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $LEX"

if ! command -v "$YACC" >/dev/null 2>&1; then
    echo "configure: error: '$YACC' not found (needed to compile src/libchisql/sql.y)" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install bison" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found $YACC"

###############################################################################
# libedit, for src/shell's interactive line editing
###############################################################################
# Try pkg-config first (handles the odd host where histedit.h lives
# under a non-standard -I, e.g. /usr/include/editline); fall back to a
# plain link test, since libedit's .pc file isn't universal.
LIBEDIT_CFLAGS=
LIBEDIT_LIBS=-ledit
libedit_ok=no

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists libedit 2>/dev/null; then
    LIBEDIT_CFLAGS=`pkg-config --cflags libedit`
    LIBEDIT_LIBS=`pkg-config --libs libedit`
    libedit_ok=yes
fi

if [ "$libedit_ok" = no ]; then
    cat > "$WORKDIR/t.c" <<'EOF'
#include <histedit.h>
int main(void) { el_init("t", 0, 0, 0); return 0; }
EOF
    if "$CC" $LIBEDIT_CFLAGS "$WORKDIR/t.c" -o "$WORKDIR/t" $LIBEDIT_LIBS >/dev/null 2>&1; then
        libedit_ok=yes
    fi
fi

if [ "$libedit_ok" = no ]; then
    echo "configure: error: libedit (histedit.h + -ledit) not found" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install libedit-dev" >&2
    note_other_pkgmgr
    exit 1
fi
echo "configure: found libedit"

###############################################################################
# Check (optional: the test suite is skipped, not fatal, if missing)
###############################################################################
CHECK_CFLAGS=
CHECK_LIBS=
HAS_CHECK=no

if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists 'check >= 0.9.14' 2>/dev/null; then
    CHECK_CFLAGS=`pkg-config --cflags check`
    CHECK_LIBS=`pkg-config --libs check`
    HAS_CHECK=yes
else
    cat > "$WORKDIR/t.c" <<'EOF'
#include <check.h>
int main(void) { suite_create("t"); return 0; }
EOF
    for libs in "-lcheck -lm -lpthread" "-lcheck_pic -lrt -lm -lsubunit -lpthread"; do
        if "$CC" "$WORKDIR/t.c" -o "$WORKDIR/t" $libs >/dev/null 2>&1; then
            CHECK_LIBS=$libs
            HAS_CHECK=yes
            break
        fi
    done
fi

if [ "$HAS_CHECK" = yes ]; then
    echo "configure: found check (CHECK_LIBS = $CHECK_LIBS)"
else
    echo "configure: warning: Check (>= 0.9.14) not found - 'make check'/'make test' will" >&2
    echo "  build everything but skip the test binaries" >&2
    echo "  install it, e.g. on Debian/Ubuntu: apt-get install check" >&2
    note_other_pkgmgr
fi

###############################################################################
# Write Makefile.config
###############################################################################
{
    echo "# Generated by ./configure - do not edit by hand, re-run ./configure instead."
    echo "CC = $CC"
    echo "AR = ar"
    echo "LEX = $LEX"
    echo "YACC = $YACC"
    echo
    echo "LIBEDIT_CFLAGS = $LIBEDIT_CFLAGS"
    echo "LIBEDIT_LIBS = $LIBEDIT_LIBS"
    echo
    echo "HAS_CHECK = $HAS_CHECK"
    echo "CHECK_CFLAGS = $CHECK_CFLAGS"
    echo "CHECK_LIBS = $CHECK_LIBS"
} > Makefile.config

echo "wrote Makefile.config"
echo
echo "Next: make            && ./chidb"
echo "  or: make check       (alias: make test)"
